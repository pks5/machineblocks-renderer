<playground:PlaygroundConfigSet xmlns="http://blockml.org/bml"
  xmlns:core="com.machineblocks.bml.core"
  xmlns:playground="com.machineblocks.bml.renderer.workspace.playground"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation">

  <baseType>
    core:ConfigSet
  </baseType>
  <is>
    A playground config profile set
  </is>
  <aggregations>
    <profiles override="true">
      <composition>
        <core:ConfigProfile bml:id="preview" name="Preview" printerLayerHeight="0.2" printerNozzleDiameter="0.4" studDiameterAdjustment="0.2" />
        <core:ConfigProfile bml:id="print" name="Print" printerLayerHeight="0.1" printerNozzleDiameter="0.25" studDiameterAdjustment="0.1" />
      </composition>
    </profiles>
  </aggregations>
</playground:PlaygroundConfigSet>
