{
  "name": "machineblocks-renderer",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "blockml": {
    "library": "./blocks/com/machineblocks/bml/renderer/workspace/Library.bml"
  },
  "dependencies": {
    "@blockml/core": "^1.4.5",
    "@machineblocks/core": "^3.0.0-A4"
  },
  "devDependencies": {
    "@blockml/block-render-engine": "workspace:*",
    "@blockml/cli": "^0.9.15",
    "@machineblocks/cli": "workspace:*",
    "@machineblocks/render-target": "workspace:*",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "scripts": {
    "build": "npm run build -w @blockml/block-render-engine && npm run build -w @machineblocks/render-target && npm run build -w @machineblocks/cli",
    "validate": "blockml validate",
    "search:index": "blockml search index",
    "vbump:major": "node scripts/vbump.mjs major",
    "vbump:minor": "node scripts/vbump.mjs minor",
    "vbump:patch": "node scripts/vbump.mjs patch",
    "deps:set": "node scripts/deps-set.mjs",
    "publish:packages": "bash scripts/publish-packages.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
