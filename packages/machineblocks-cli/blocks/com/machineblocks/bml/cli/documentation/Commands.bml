<!--CLI Documentation — Commands
  FQN: com.machineblocks.bml.cli.documentation.Commands-->
<clidoc:Commands xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:clidoc="com.machineblocks.bml.cli.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Command inventory
  </is>
  <documentation>
    <![CDATA[
    Host commands:
    • validate — parser + semantic check; no SCAD target; no output files
    • compile — render machineblocks-v3-scad for one type selector; writes under srcDir
    • init — scaffold a BlockML project and record the MachineBlocks profile
    • update — point @machineblocks/cli, @machineblocks/core, @blockml/cli, and
      @blockml/core at this host's versions

    Not on this host (use blockml when that package is installed): watch, search,
    scan, inspect, graph, transform, new, agents-md, xsd toggle, thumbnail generation.

    Per-target matrix entry this host satisfies:

        machineblocks-v3-scad — document target; selected by type selector;
        written under srcDir; registered by @machineblocks/cli, not by @blockml/cli.

    Printed operator help: clidoc:Help (root) and each command documentation Printed help section.
    ]]>
  </documentation>
  <references>
    <see type="clidoc:Help" relation="ReadNext" />
    <see type="clidoc:ValidateCommand" relation="SeeAlso" />
    <see type="clidoc:CompileCommand" relation="SeeAlso" />
    <see type="clidoc:InitCommand" relation="SeeAlso" />
    <see type="clidoc:UpdateCommand" relation="SeeAlso" />
  </references>
</clidoc:Commands>
