<!--Render Target — CustomizerRules
  FQN: com.machineblocks.bml.target.render.CustomizerRules-->
<render:CustomizerRules xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:render="com.machineblocks.bml.target.render">

  <baseType>
    core:Block
  </baseType>
  <is>
    Catalog of customizer projections
  </is>
  <documentation>
    The render target reads this block from the type registry and projects matching properties into customizer fields.

    - Axis rules are considered before sentinel rules.
    - A union with no matching rule stays one variable.
    - Axis rules expand a number scalar into an AxisXY or AxisXYZ vector on the property name.
    - Sentinel rules cover a constant plus one flat value: Auto with Decimal, and Boolean.False with Text or FilePath.
    - Boolean axes, enum axes, and three-arm unions stay one variable.
  </documentation>
  <aggregations>
    <axes type="render:AxisVector[]">
      <documentation>
        Number scalar or axis vector, considered before sentinel toggles.
      </documentation>
      <composition>
        <render:AxisVector bml:id="decimal-xy" valueType="org.blockml.bml.type.Decimal" axis="com.machineblocks.bml.type.AxisXY" />
        <render:AxisVector bml:id="decimal-xyz" valueType="org.blockml.bml.type.Decimal" axis="com.machineblocks.bml.type.AxisXYZ" />
        <render:AxisVector bml:id="integer-xy" valueType="org.blockml.bml.type.Integer" axis="com.machineblocks.bml.type.AxisXY" />
        <render:AxisVector bml:id="integer-xyz" valueType="org.blockml.bml.type.Integer" axis="com.machineblocks.bml.type.AxisXYZ" />
      </composition>
    </axes>
    <rules type="render:SentinelToggle[]">
      <documentation>
        Sentinel toggles, in match order.
      </documentation>
      <composition>
        <render:SentinelToggle bml:id="auto-decimal" sentinel="com.machineblocks.bml.type.Auto" valueType="org.blockml.bml.type.Decimal" checkboxSelects="sentinel" checkboxSuffix="Auto" inactiveDefault="0" />
        <render:SentinelToggle bml:id="false-text" sentinel="org.blockml.bml.type.Boolean.False" valueType="org.blockml.bml.type.Text" checkboxSelects="value" checkboxSuffix="On" inactiveDefault="&quot;&quot;" />
        <render:SentinelToggle bml:id="false-file" sentinel="org.blockml.bml.type.Boolean.False" valueType="org.blockml.bml.type.FilePath" checkboxSelects="value" checkboxSuffix="On" inactiveDefault="&quot;&quot;" />
      </composition>
    </rules>
  </aggregations>
</render:CustomizerRules>
