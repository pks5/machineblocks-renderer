<!--Render Target — CustomizerRules
  FQN: com.machineblocks.bml.target.render.CustomizerRules-->
<render:CustomizerRules xmlns="http://blockml.org/bml"
  xmlns:bml="org.blockml.bml.annotation.BmlAnnotation"
  xmlns:core="org.blockml.bml.core"
  xmlns:render="com.machineblocks.bml.target.render">

  <baseType>
    core:Block
  </baseType>
  <is>
    Catalog of customizer projections
  </is>
  <documentation>
    The render target reads this block from the type registry and projects matching properties into customizer fields.

    - Type splits are considered first, then number axes, boolean axes, and enum axes, then sentinel rules.
    - A property with no matching rule stays one variable.
    - A type split matches one struct type and opens a customizer tab of numbered fields. A hidden variable rebuilds the array.
    - Number axis rules expand a number scalar into an AxisXY or AxisXYZ vector on the property name.
    - Boolean axis rules split a Boolean scalar into one checkbox per axis. A hidden variable rebuilds the array.
    - Enum axis rules split an enum scalar into one token per axis. Each field keeps the enum dropdown. A hidden variable rebuilds the array.
    - Sentinel rules cover a constant plus one flat value: Auto with Decimal, and Boolean.False with Text or FilePath.
    - Three-arm unions stay one variable.
  </documentation>
  <aggregations>
    <splits type="render:TypeSplit[]">
      <documentation>
        Struct splits, considered before axis and sentinel rules.
      </documentation>
      <composition>
        <render:TypeSplit bml:id="bevel" type="com.machineblocks.bml.type.Bevel" group="Bevel" range="[0:0.25:128]">
          <descriptions><![CDATA[Bevel X and Y for the corner [0,0] (grid)
Bevel X and Y for the corner [0,1] (grid)
Bevel X and Y for the corner [1,1] (grid)
Bevel X and Y for the corner [1,0] (grid)]]></descriptions>
        </render:TypeSplit>
      </composition>
    </splits>
    <axes type="render:AxisVector[]">
      <documentation>
        Number scalar or axis vector, considered before sentinel toggles.
      </documentation>
      <composition>
        <render:AxisVector bml:id="decimal-xy" valueType="org.blockml.bml.type.Decimal" axis="com.machineblocks.bml.type.AxisXY" />
        <render:AxisVector bml:id="decimal-xyz" valueType="org.blockml.bml.type.Decimal" axis="com.machineblocks.bml.type.AxisXYZ" />
        <render:AxisVector bml:id="integer-xy" valueType="org.blockml.bml.type.Integer" axis="com.machineblocks.bml.type.AxisXY" />
        <render:AxisVector bml:id="integer-xyz" valueType="org.blockml.bml.type.Integer" axis="com.machineblocks.bml.type.AxisXYZ" />
      </composition>
    </axes>
    <components type="render:AxisComponents[]">
      <documentation>
        Boolean or enum scalar, one field per axis.
      </documentation>
      <composition>
        <render:AxisComponents bml:id="boolean-xy" valueType="org.blockml.bml.type.Boolean" axis="com.machineblocks.bml.type.AxisXY" />
        <render:AxisComponents bml:id="boolean-xyz" valueType="org.blockml.bml.type.Boolean" axis="com.machineblocks.bml.type.AxisXYZ" />
        <render:AxisComponents bml:id="enum-xy" valueType="enum" axis="com.machineblocks.bml.type.AxisXY" />
        <render:AxisComponents bml:id="enum-xyz" valueType="enum" axis="com.machineblocks.bml.type.AxisXYZ" />
      </composition>
    </components>
    <rules type="render:SentinelToggle[]">
      <documentation>
        Sentinel toggles, in match order.
      </documentation>
      <composition>
        <render:SentinelToggle bml:id="auto-decimal" sentinel="com.machineblocks.bml.type.Auto" valueType="org.blockml.bml.type.Decimal" checkboxSelects="sentinel" checkboxSuffix="Auto" inactiveDefault="0" />
        <render:SentinelToggle bml:id="false-text" sentinel="org.blockml.bml.type.Boolean.False" valueType="org.blockml.bml.type.Text" checkboxSelects="value" checkboxSuffix="On" inactiveDefault="&quot;&quot;" />
        <render:SentinelToggle bml:id="false-file" sentinel="org.blockml.bml.type.Boolean.False" valueType="org.blockml.bml.type.FilePath" checkboxSelects="value" checkboxSuffix="On" inactiveDefault="&quot;&quot;" />
      </composition>
    </rules>
  </aggregations>
</render:CustomizerRules>
