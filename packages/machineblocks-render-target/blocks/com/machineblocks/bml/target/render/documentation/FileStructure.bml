<!--Render Target Documentation — FileStructure
  FQN: com.machineblocks.bml.target.render.documentation.FileStructure-->
<rdoc:FileStructure xmlns="http://blockml.org/bml"
  xmlns:core="org.blockml.bml.core"
  xmlns:rdoc="com.machineblocks.bml.target.render.documentation">

  <baseType>
    core:Documentation
  </baseType>
  <is>
    Required section order of a generated SCAD block file
  </is>
  <documentation>
    Every generated SCAD file follows the MachineBlocks block file structure.
    The header is mandatory. Section comments are mandatory even when the
    section is empty.

        /**
         * MachineBlocks.com Block File
         *
         * Name: Wall
         * Filename: Wall.scad
         * Package: com.martianmicro.anyclosure.Wall
         * Generated by: machineblocks-render-target (package version)
         */

        /* Imports */
        /* Customization */
        /* Main Module Call */
        /* Main Module Definition */
        /* Optional Sub Modules */
        /* Optional Helper Modules */
        /* Optional Global Functions */

    The historical header said "Generated by: bom" plus a version token. New files say
    machineblocks-render-target plus this package version.

  </documentation>
  <references>
    <see type="rdoc:SettingsFormat" relation="ReadNext" />
  </references>
</rdoc:FileStructure>
